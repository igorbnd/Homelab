# Copy to .env and adjust. Run scripts/00-preflight.sh to populate automatically.

# MetalLB address for the Orca Service. Must be free and inside your pool.
ORCA_LB_IP=10.0.0.10          # CHANGE ME: a free address in your MetalLB pool

# Base domain for Orca subdomain routing. Registry name becomes the first label,
# e.g. dockerhub.orca.lan -> the registry named "dockerhub".
ORCA_DOMAIN=orca.lan

# Kubernetes namespace for Orca.
ORCA_NAMESPACE=orca

# Prometheus OTLP receiver endpoint (must end with /v1/metrics for http/protobuf).
PROM_OTLP_ENDPOINT=http://prometheus-operated.monitoring.svc.cluster.local:9090/api/v1/otlp/v1/metrics

# Prometheus query endpoint, used by the metric-discovery script.
PROM_QUERY_URL=http://prometheus-operated.monitoring.svc.cluster.local:9090

# Cluster nodes. Orca is scheduled only on ORCA_NODES; all NODES get the mirror config.
NODES="node1.example.lan node2.example.lan node3.example.lan"   # CHANGE ME: SSH targets
ORCA_NODES="k3s-master01 k3s-node2-nuc"

# Image used for cold/warm pull benchmarks. Large enough to be measurable.
BENCH_IMAGE=docker.io/library/node:latest
